# Project Lucca Environment Configuration

# vLLM Server (WSL2)
LUCCA_VLLM_URL=http://localhost:8000/v1
LUCCA_VLLM_MODEL=fixie-ai/ultravox-v0_5-llama-3_1-8b

# OpenVINO NPU Engine
LUCCA_OPENVINO_DEVICE=NPU
LUCCA_OPENVINO_CACHE_DIR=./var/cache/openvino

# Audio Configuration
LUCCA_AUDIO_SAMPLE_RATE=24000
LUCCA_PTT_KEY=caps_lock

# Sandbox Configuration
LUCCA_SANDBOX_WORKSPACE=./var/sandbox/workspace
LUCCA_SANDBOX_PERSIST=./var/sandbox/persist

# Orchestrator Security
LUCCA_HMAC_SECRET_KEY=change_this_to_a_secure_random_key_in_production
