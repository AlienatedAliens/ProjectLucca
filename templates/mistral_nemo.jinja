{{- bos_token }}
{%- if messages[0]['role'] == 'system' %}
    {%- set system_message = messages[0]['content']|trim %}
    {%- set messages = messages[1:] %}
{%- else %}
    {%- set system_message = '' %}
{%- endif %}
{%- if system_message != '' %}
    {{- '[SYSTEM_PROMPT]' + system_message + '[/SYSTEM_PROMPT]' }}
{%- endif %}
{%- if tools is not none and tools|length > 0 %}
    {{- '[AVAILABLE_TOOLS]' + tools|tojson + '[/AVAILABLE_TOOLS]' }}
{%- endif %}
{%- for message in messages %}
    {%- if message['role'] == 'user' %}
        {%- if message.content is string %}
            {{- '[INST] ' + message['content']|trim + ' [/INST]' }}
        {%- elif message.content is iterable %}
            {%- set user_text = namespace(val='') %}
            {%- for part in message.content %}
                {%- if part.type == 'text' %}
                    {%- set user_text.val = user_text.val + part.text %}
                {%- endif %}
            {%- endfor %}
            {{- '[INST] ' + user_text.val|trim + ' [/INST]' }}
        {%- endif %}
    {%- elif message['role'] == 'assistant' %}
        {%- if message.tool_calls is defined and message.tool_calls is not none and message.tool_calls|length > 0 %}
            {{- '[TOOL_CALLS] ' + message.tool_calls|tojson + ' [/TOOL_CALLS]' }}
        {%- endif %}
        {%- if message['content'] is defined and message['content'] is not none and message['content']|trim != '' %}
            {{- ' ' + message['content']|trim + eos_token }}
        {%- endif %}
    {%- elif message['role'] == 'tool' %}
        {{- '[TOOL_RESULTS] ' + '{"call_id": "' + (message.tool_call_id|default("")) + '", "content": ' + message['content']|tojson + '} [/TOOL_RESULTS]' }}
    {%- endif %}
{%- endfor %}
