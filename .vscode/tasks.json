{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lucca: Verify Environment (env-check)",
      "type": "shell",
      "command": "uv run lucca-admin env-check",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Lucca: Run Tier 1-2 Unit Tests",
      "type": "shell",
      "command": "uv run pytest -m \"not hw and not soak\" -v",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Lucca: Run All Tests (incl. HW)",
      "type": "shell",
      "command": "uv run pytest tests/ -v",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Lucca: Static Quality Gates (Ruff & Mypy)",
      "type": "shell",
      "command": "uv run ruff check src/ tests/ && uv run mypy src/",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Lucca: Configure WSL2 Memory Clamp",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts/setup_wslconfig.ps1",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Lucca: Run Supervisor (Main)",
      "type": "shell",
      "command": "uv run python -m lucca.main",
      "isBackground": false,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}
