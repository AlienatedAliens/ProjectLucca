{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lucca: Verify Environment & Hardware",
      "type": "shell",
      "command": "uv run python scripts/verify_environment.py",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Lucca: Run All Tests",
      "type": "shell",
      "command": "uv run pytest tests/ -v",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Lucca: Configure WSL2 Memory Clamp",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts/setup_wslconfig.ps1",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Lucca: Start vLLM in WSL2",
      "type": "shell",
      "command": "wsl -d Ubuntu -e bash -c \"vllm serve fixie-ai/ultravox-v0_5-llama-3_1-8b --gpu-memory-utilization 0.62 --port 8000\"",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}
