root ::= ws (def-func | return-stmt | for-loop | if-stmt | expr-stmt)+ ws
def-func ::= "def " func-name "(" param-list "):" newline body
func-name ::= [a-zA-Z_][a-zA-Z0-9_]*
param-list ::= (param ("," ws param)*)?
param ::= [a-zA-Z_][a-zA-Z0-9_]*
body ::= (indent-stmt newline)+
indent-stmt ::= "    " (return-stmt | for-loop | if-stmt | assign-stmt | expr-stmt)
return-stmt ::= "return " expr
for-loop ::= "for " var " in " range-call ":" newline "        " (assign-stmt | if-stmt | return-stmt)
range-call ::= "range(" (expr ("," ws expr)*) ")"
if-stmt ::= "if " expr " " comp-op " " expr ":" newline "        " (return-stmt | assign-stmt)
assign-stmt ::= var " = " expr
expr-stmt ::= expr
comp-op ::= "==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not in"
expr ::= hole | var | number | string | binary-expr | call-expr
binary-expr ::= expr " " bin-op " " expr
bin-op ::= "+" | "-" | "*" | "//" | "/" | "%"
call-expr ::= func-name "(" (expr ("," ws expr)*)? ")"
hole ::= "?hole-bound" | "?hole-op" | "?hole-val" | "?hole-ret" | "?hole-cond"
var ::= [a-zA-Z_][a-zA-Z0-9_]*
number ::= "-"? [0-9]+
string ::= "\"" [^\"\n]* "\""
ws ::= [ \t]*
newline ::= [\n]+
