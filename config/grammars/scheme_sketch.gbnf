root ::= ws expr-list ws
expr-list ::= expr (ws expr)*
expr ::= atom | list
list ::= "(" ws (expr (ws expr)*)? ws ")"
atom ::= symbol | keyword | string | number | boolean
boolean ::= "#t" | "#f"
number ::= float | int
int ::= "-"? [0-9]+
float ::= "-"? [0-9]+ "." [0-9]+
string ::= "\"" ([^"\\] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]))* "\""
keyword ::= ":" [a-zA-Z] [a-zA-Z0-9_-]*
symbol ::= symbol-alpha | symbol-op
symbol-alpha ::= [a-zA-Z_?] [a-zA-Z0-9_?=<>!-]*
symbol-op ::= [+\-*/<>=]+
ws ::= ([ \t\n\r] | comment)*
comment ::= ";" [^\n]* [\n]
