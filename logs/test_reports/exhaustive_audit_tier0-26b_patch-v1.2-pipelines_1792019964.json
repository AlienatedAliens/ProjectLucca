      "synthesized_program": "def get_bounding_box (grid ,target_color ):\n    \"\"\"\n    Finds the bounding box coordinates of a specific color in a 2D grid.\n    Returns (min_row, min_col, max_row, max_col) or None if color not found.\n    \"\"\"\n    rows =len (grid )\n    cols =len (grid [0 ])\n    min_r ,min_c ,max_r ,max_c =rows ,cols ,-1 ,-1 \n    found =False \n\n    for r in range (rows ):\n        for c in range (cols ):\n            if grid [r ][c ]==target_color :\n                found =True \n                if r <min_r :min_r =r \n                if r >max_r :max_r =r \n                if c <min_c :min_c =c \n                if c >max_c :max_c =c \n\n    return (min_r ,min_c ,max_r ,max_c )if found else None\n\ndef transform (grid :list [list [int ]])->list [list [int ]]:\n    rows =len (grid )\n    cols =len (grid [0 ])\n\n    # Find the divider line (color 6)\n    divider_row =-1 \n    for r in range (rows ):\n        if grid [r ][0 ]==6 :\n            divider_row =r \n            break \n\n            # Search only in the top half (above the divider)\n    search_limit =divider_row if divider_row !=-1 else rows \n\n    target_color =-1 \n    coords =None \n\n    # Find the single non-zero object in the top half\n    for r in range (search_limit ):\n        for c in range (cols ):\n            if grid [r ][c ]!=0 :\n                target_color =grid [r ][c ]\n                # Use a simple bounding box logic to find the object\n                min_r ,min_c ,max_r ,max_c =rows ,cols ,-1 ,-1 \n                found =False \n                for r_idx in range (search_limit ):\n                    for c_idx in range (cols ):\n                        if grid [r_idx ][c_idx ]==target_color :\n                            found =True \n                            min_r =min (min_r ,r_idx )\n                            max_r =max (max_r ,r_idx )\n                            min_c =min (min_c ,c_idx )\n                            max_c =max (max_c ,c_idx )\n                if found :\n                    coords =(min_r ,min_c ,max_r ,max_c )\n                    break \n        if coords :break \n\n    if not coords :\n        return []\n\n        # Extract the bounding box\n    min_r ,min_c ,max_r ,max_c =coords \n    return [row [min_c :max_c +1 ]for row in grid [min_r :max_r +1 ]]",
